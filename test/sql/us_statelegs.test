# name: test/sql/us_statelegs.test
# description: SQL-level tests for the us_statelegs worker against recorded fixtures (ci/run-integration.sh)
# group: [us_statelegs]

require vgi

require-env US_STATELEGS_WORKER

require-env US_STATELEGS_MOCK_API

require-env US_STATELEGS_CACHE_DIR

statement ok
ATTACH 'us_statelegs' (TYPE vgi, LOCATION '{US_STATELEGS_WORKER}',
    CACHE_DIR '{US_STATELEGS_CACHE_DIR}/main',
    PEOPLE_ARCHIVE_URL '{US_STATELEGS_MOCK_API}/files/people.tar.gz',
    KLARNER_URL '{US_STATELEGS_MOCK_API}/files/klarner.tab',
    SHOR_MCCARTY_URL '{US_STATELEGS_MOCK_API}/files/shor_mccarty_individual.tab',
    SHOR_MCCARTY_AGGREGATE_URL '{US_STATELEGS_MOCK_API}/files/shor_mccarty_aggregate.tab',
    OPENSTATES_API_URL '{US_STATELEGS_MOCK_API}/v3',
    OPENSTATES_MIN_INTERVAL 0);

# ---------------------------------------------------------------- reference (bundled)

query IIT
SELECT count(*), count(*) FILTER (WHERE unicameral), string_agg(state, ',' ORDER BY state) FILTER (WHERE unicameral)
FROM us_statelegs.main.states;
----
52	2	DC,NE

query TTTT
SELECT state, state_fips, jurisdiction_id, list_aggregate(chambers, 'string_agg', ',')
FROM us_statelegs.main.states WHERE state IN ('NE', 'PR', 'AL') ORDER BY state;
----
AL	01	ocd-jurisdiction/country:us/state:al/government	upper,lower
NE	31	ocd-jurisdiction/country:us/state:ne/government	legislature
PR	72	ocd-jurisdiction/country:us/territory:pr/government	upper,lower

# ---------------------------------------------------------------- cache (nothing downloaded yet)

query TT
SELECT dataset, cached FROM us_statelegs.main.cache_info() ORDER BY dataset;
----
klarner_election_returns	false
people	false
shor_mccarty_aggregate	false
shor_mccarty_individual	false

# ---------------------------------------------------------------- legislators (people repository fixture: NE + DC)

query TTI
SELECT state, current, count(*) FROM us_statelegs.main.legislators() GROUP BY ALL ORDER BY ALL;
----
DC	false	19
DC	true	13
NE	false	103
NE	true	49

query TTTTI
SELECT name, chamber, district, party, roles
FROM us_statelegs.main.legislators(state := 'ne', current := true) ORDER BY district::INTEGER LIMIT 3;
----
Bob Hallstrom	legislature	1	Nonpartisan	1
Rob Clements	legislature	2	Nonpartisan	1
Victor Rountree	legislature	3	Nonpartisan	1

# A pushed-down state filter, a FIPS code argument and an IN list.
query I
SELECT count(*) FROM us_statelegs.main.legislators() WHERE state = 'NE' AND current;
----
49

query I
SELECT count(*) FROM us_statelegs.main.legislators(state := '31', current := true);
----
49

query T
SELECT string_agg(DISTINCT state, ',' ORDER BY state) FROM us_statelegs.main.legislators() WHERE state IN ('DC', 'NE');
----
DC,NE

# A state the fixture has no files for returns no rows; an unknown code is an error.
query I
SELECT count(*) FROM us_statelegs.main.legislators(state := 'NC');
----
0

statement error
SELECT count(*) FROM us_statelegs.main.legislators(state := 'ZZ');
----
<REGEX>:.*unknown state.*

query TTT
SELECT name, email, instagram FROM us_statelegs.main.legislators(state := 'NE') WHERE district = '13' AND current;
----
Ashlei Spivey	aspivey@leg.ne.gov	ashleiforne

query TI
SELECT state, count(*) FROM us_statelegs.main.legislator_roles() GROUP BY ALL ORDER BY ALL;
----
DC	35
NE	158

# ---------------------------------------------------------------- committees

query TTI
SELECT name, chair, members FROM us_statelegs.main.committees(state := 'NE') WHERE name = 'Agriculture';
----
Agriculture	Barry DeKay	8

query TT
SELECT m.role, l.name FROM us_statelegs.main.committee_members(state := 'NE') m
JOIN us_statelegs.main.legislators(state := 'NE') l USING (person_id)
WHERE m.committee_name = 'Agriculture' AND m.role <> 'member' ORDER BY m.role;
----
chair	Barry DeKay
vice chair	Teresa Ibach

# ---------------------------------------------------------------- Klarner election returns (fixture: NE 2014/2016, VT 2016, WI 2016 lower)

query TITII
SELECT state, year, chamber, count(*), sum(votes) FROM us_statelegs.main.election_returns() GROUP BY ALL ORDER BY ALL;
----
NE	2014	legislature	179	407906
NE	2016	legislature	111	369739
VT	2016	lower	347	410008
VT	2016	upper	66	666315
WI	2016	lower	261	2587171

query II
SELECT count(*), count(DISTINCT year) FROM us_statelegs.main.election_returns(state := 'NE') WHERE year >= 2016;
----
111	1

query I
SELECT count(*) FROM us_statelegs.main.election_returns(state := 'VT', chamber := 'upper', first_year := 2016, last_year := 2016);
----
66

query TTTTIT
SELECT district, candidate, party, incumbent, votes, outcome FROM us_statelegs.main.election_returns(state := 'VT', chamber := 'upper')
WHERE election_type = 'g' AND district = 'Addison' ORDER BY votes DESC LIMIT 2;
----
Addison	ayer, claire	d	true	11988	w
Addison	bray, christopher a.	d	true	9545	w

# ---------------------------------------------------------------- Shor-McCarty (fixture: April 2023 CC0 release, NE + VT)

query TTIIII
SELECT state, chamber, count(*), count(DISTINCT legislator_id), min(year), max(year)
FROM us_statelegs.main.legislator_ideology() GROUP BY ALL ORDER BY ALL;
----
NE	legislature	1222	199	1996	2020
VT	lower	3923	587	1995	2020
VT	upper	790	103	1995	2020

query ITRR
SELECT year, chamber, median, party_gap FROM us_statelegs.main.chamber_ideology(state := 'NE', first_year := 2019);
----
2019	legislature	0.568	1.757
2020	legislature	0.568	1.757

query I
SELECT count(*) FROM us_statelegs.main.chamber_ideology() WHERE state = 'VT' AND year = 2010;
----
2

# ---------------------------------------------------------------- cache after use

query TTT
SELECT dataset, cached, status FROM us_statelegs.main.cache_info() ORDER BY dataset;
----
klarner_election_returns	true	cached
people	true	cached
shor_mccarty_aggregate	true	cached
shor_mccarty_individual	true	cached

query TT
SELECT dataset, status FROM us_statelegs.main.refresh_cache('people');
----
people	downloaded

# ---------------------------------------------------------------- Open States API (mock; needs the openstates secret)

statement error
SELECT count(*) FROM us_statelegs.main.os_jurisdictions();
----
<REGEX>:.*TYPE openstates.*

statement ok
CREATE SECRET os_test (TYPE openstates, API_KEY 'test-key');

query TT
SELECT state, name FROM us_statelegs.main.os_jurisdictions() ORDER BY state;
----
NC	North Carolina
NE	Nebraska

query TTI
SELECT session, name, len(downloads) FROM us_statelegs.main.os_sessions(state := 'NE') ORDER BY session;
----
108	108th Legislature (2023-2024)	1
109	109th Legislature (2025-2026)	0

# Three pages of 20 / 20 / 9 people.
query IIT
SELECT count(*), count(DISTINCT district), min(chamber) FROM us_statelegs.main.os_people(state := 'NE');
----
49	49	legislature

query T
SELECT name FROM us_statelegs.main.os_people(state := 'NE', district := '13');
----
Ashlei Spivey

query TTTT
SELECT identifier, chamber, first_action_date, sponsors[1].name FROM us_statelegs.main.os_bills(state := 'NE', session := '109') ORDER BY identifier;
----
LB 1	legislature	2025-01-09	Bob Hallstrom
LB 2	legislature	2025-01-09	Victor Rountree
LR 3	legislature	2025-01-15	Rob Clements

# updated_at >= ... is pushed to the API as updated_since.
query T
SELECT identifier FROM us_statelegs.main.os_bills() WHERE state = 'NE' AND updated_at >= TIMESTAMPTZ '2026-09-15 00:00:00+00' ORDER BY 1;
----
LB 1
LB 2

statement error
SELECT count(*) FROM us_statelegs.main.os_bills();
----
<REGEX>:.*jurisdiction or search.*

query TTIIIT
SELECT bill_identifier, result, yes, no, other, votes[3].option FROM us_statelegs.main.os_votes(state := 'NE') ORDER BY 1;
----
LB 1	pass	41	6	2	no
LR 3	fail	12	30	7	NULL

query TTT
SELECT l.name, v.option, l.district FROM us_statelegs.main.os_votes(state := 'NE') o, unnest(o.votes) AS u(v)
JOIN us_statelegs.main.legislators(state := 'NE') l ON l.person_id = v.person_id
WHERE o.bill_identifier = 'LB 1' ORDER BY l.district::INTEGER;
----
Bob Hallstrom	yes	1
Rob Clements	yes	2
Victor Rountree	no	3

query TTI
SELECT state, name, len(members) FROM us_statelegs.main.os_committees(state := 'NE') ORDER BY name;
----
NE	Agriculture	2
NE	Appropriations	0

query TTT
SELECT name, status, agenda[1].description FROM us_statelegs.main.os_events(state := 'NE') ORDER BY start_time;
----
Agriculture Committee Hearing	tentative	LB 2
Floor Session	cancelled	NULL

statement error
SELECT count(*) FROM us_statelegs.main.os_events();
----
<REGEX>:.*needs a state.*

# ---------------------------------------------------------------- OFFLINE with an empty cache fails clearly

statement ok
ATTACH 'us_statelegs' AS offline_sl (TYPE vgi, LOCATION '{US_STATELEGS_WORKER}',
    CACHE_DIR '{US_STATELEGS_CACHE_DIR}/empty', OFFLINE true,
    PEOPLE_ARCHIVE_URL '{US_STATELEGS_MOCK_API}/files/people.tar.gz');

statement error
SELECT count(*) FROM offline_sl.main.legislators(state := 'NE');
----
<REGEX>:.*OFFLINE.*
